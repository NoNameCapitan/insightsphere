# Public application configuration
NEXT_PUBLIC_SITE_URL=https://vetnear.example
NEXT_PUBLIC_BACKEND_ENABLED=1
NEXT_PUBLIC_SHOW_DEMO_EMERGENCY=0
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PETSCAN_PROVIDER=

# Supabase — server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public ("anon" / publishable) key, used ONLY on the server for user sign-in
# and for reading/writing pet cards under the user's own JWT (RLS applies).
# Never put the service-role key here.
SUPABASE_ANON_KEY=

# Required production privacy salt (generate 32+ random bytes)
LEAD_HASH_SALT=

# Distributed rate limit / moderator lockout (Upstash REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live safety data — server only. Never use NEXT_PUBLIC_ for this token.
UKRAINE_ALARM_API_TOKEN=
KYIV_SHELTERS_ARCGIS_URL=

# Optional AI assistant — server only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional import tooling — server/CLI only
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Direct PostgreSQL URL used only by npm run db:postcheck
DB_URL=

# Legacy bootstrap secret intentionally omitted. Use personal moderator tokens.
# ADMIN_TOKEN=
