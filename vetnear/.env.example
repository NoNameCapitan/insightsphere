# VetNear environment template. Copy to .env.local and fill in.
# NEVER commit real values. NEVER add NEXT_PUBLIC_ to secrets.

# ── Site / SEO ───────────────────────────────────────────────────────────────
# Canonical production URL (no trailing slash). Used for sitemap, robots,
# canonical links, OpenGraph and JSON-LD. Without it, a placeholder
# https://vetnear.example.com is used — set this in Vercel for production:
# NEXT_PUBLIC_SITE_URL=https://your-final-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── AI assistant (server-only, OPTIONAL) ─────────────────────────────────────
# The MVP assistant is a free local rules engine and needs NO key at all.
# An Anthropic key only enables the optional server "smart mode" later.
# OpenAI API is not required (and not used) anywhere in the MVP.
ANTHROPIC_API_KEY=

# ── Supabase backend (Phase 2, server-only) ─────────────────────────────────
# Project URL + SERVICE ROLE key (Settings → API). The service role key
# bypasses RLS and must exist ONLY on the server — never expose it to the
# frontend and never prefix it with NEXT_PUBLIC_. Do not use the anon key here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Moderator token for /api/admin/* (choose a long random string, e.g.
# `openssl rand -hex 32`). Must be set in Vercel for server admin mode;
# without it the admin API stays disabled.
ADMIN_TOKEN=

# ── Public flags (safe for the browser) ─────────────────────────────────────
# "1" => client pushes submissions/reports to the server API and the
# moderation page shows the server queue. Empty => pure localStorage demo.
NEXT_PUBLIC_BACKEND_ENABLED=
