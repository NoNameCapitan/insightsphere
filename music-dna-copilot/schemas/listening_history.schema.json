{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized Listening History",
  "description": "A unified schema for listening history data from any supported source (Spotify, Last.fm, CSV, manual input).",
  "type": "object",
  "required": ["source", "exported_at", "tracks"],
  "properties": {
    "source": {
      "type": "string",
      "description": "The origin of the data.",
      "enum": ["spotify", "lastfm", "csv", "json", "manual"]
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the data was exported or imported."
    },
    "user_id": {
      "type": "string",
      "description": "Optional anonymized user identifier."
    },
    "tracks": {
      "type": "array",
      "description": "List of listened tracks.",
      "items": {
        "type": "object",
        "required": ["track_name", "artist_name"],
        "properties": {
          "track_name": {
            "type": "string",
            "description": "Name of the track."
          },
          "artist_name": {
            "type": "string",
            "description": "Primary artist name."
          },
          "album_name": {
            "type": "string",
            "description": "Album name (if available)."
          },
          "genres": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Genre tags associated with the artist or track."
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the track was played."
          },
          "duration_ms": {
            "type": "integer",
            "description": "Track duration in milliseconds."
          },
          "play_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of times the track was played (for aggregated data)."
          },
          "audio_features": {
            "type": "object",
            "description": "Audio features (if available from source API).",
            "properties": {
              "energy": { "type": "number", "minimum": 0, "maximum": 1 },
              "valence": { "type": "number", "minimum": 0, "maximum": 1 },
              "danceability": { "type": "number", "minimum": 0, "maximum": 1 },
              "tempo": { "type": "number", "description": "BPM" },
              "acousticness": { "type": "number", "minimum": 0, "maximum": 1 },
              "instrumentalness": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "time_range": {
            "type": "string",
            "enum": ["short_term", "medium_term", "long_term"],
            "description": "Spotify time range classification."
          }
        }
      }
    }
  }
}
