# Music Taste Recommender — local configuration (.env)
# Copy this file to ".env" and fill in only what you use. Everything is optional;
# the app runs fully locally with the demo library, manual input, and file imports.
# This file must never contain real secrets in version control.

# --- Spotify (optional, read-only OAuth) ---------------------------------
# Create an app at https://developer.spotify.com/dashboard and set the redirect
# URI below in the dashboard. Only a Client ID is needed (PKCE, no secret).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/spotify/callback

# --- Last.fm (optional, read-only public data) ---------------------------
# Get an API key at https://www.last.fm/api/account/create
# Only an API key + username are needed for public reads (no password/secret).
# NOTE: the live Last.fm API connector is implemented (read-only). With these set
# you can import recent scrobbles as a history source and use Last.fm "similar
# tracks" to expand the candidate pool. See LASTFM_SETUP.md.
LASTFM_API_KEY=
LASTFM_USERNAME=

# --- Ollama (optional, fully local AI explanation enhancer) --------------
# Only used if you run Ollama locally; no data leaves your machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# No OpenAI/Anthropic or other paid API keys are used by this project.

# --- Optional: light support / branding (no payments) --------------------
# If set, the local UI footer shows a single "Support this project" link.
SUPPORT_URL=
# If set, exported Music DNA reports include this name.
REPORT_BRANDING_NAME=
