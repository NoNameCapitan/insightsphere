{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "includeFiles": "{api,scripts,examples,data,schemas,index.html}/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
