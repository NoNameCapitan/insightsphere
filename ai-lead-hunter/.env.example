# Node.js 22.19+ (recommended: current Node.js 24 LTS)
# Copy to .env.local, or set these in your hosting environment.
# With no keys the app automatically runs with clearly labelled demo data.

# Required for real search: enable Places API (New) and billing in Google Cloud.
# Server-side only. Restrict this key to Places API (New).
GOOGLE_PLACES_API_KEY=

# Optional Google map. Without it the app uses a free OpenStreetMap map.
# This key is public by design; restrict by website referrer + API.
# Enable Maps JavaScript API. Rebuild after changing NEXT_PUBLIC_* variables.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEFAULT_CITY=Київ
NEXT_PUBLIC_DEFAULT_COUNTRY=Україна

# Optional AI draft generation: openai | anthropic | openai_compatible | none
# No AI requests are made until the user clicks Improve with AI (or Check AI).
AI_PROVIDER=none
AI_PROVIDER_API_KEY=
# Exact model identifier available in your provider account.
# anthropic defaults to claude-opus-5 when empty; other providers require it.
AI_MODEL=
# Only for openai_compatible (Chat Completions API), e.g.
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1   (no key needed)
AI_BASE_URL=

# Optional workspace password: set a strong value before public hosting with paid keys.
# Browser asks for HTTP Basic login: any username + this password. HTTPS required.
APP_PASSWORD=
