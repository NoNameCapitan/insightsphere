# setup створює DATABASE_URL з абсолютним шляхом автоматично.
DATABASE_URL="file:/absolute/path/vlk-offline-app/data/vlk.sqlite"
APP_ORIGIN="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1
COMMISSION_NAME="ВЛК установи"
ORDER_402_REVISION="За редакцією, чинною на дату огляду"
# Для LAN: вкажіть реальну адресу локального сервера в APP_ORIGIN / ALLOWED_ORIGINS.
# HTTPS: COOKIE_SECURE=true; TLS завершується локальним reverse proxy.
# Не додавайте префікс NEXT_PUBLIC_ до приватних налаштувань.
